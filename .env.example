# .env.example
# ============
# Tohle je VZOR souboru s tajnými údaji.
# Zkopíruj tento soubor a přejmenuj kopii na ".env" (bez "example"):
#
#   cp .env.example .env
#
# Do nového souboru ".env" pak doplň svoje skutečné hodnoty.
# Soubor ".env" se NIKDY nenahrává do gitu (viz .gitignore) - obsahuje
# citlivé údaje, které nemají být veřejné.

# API klíč pro Anthropic (Claude). Získáš ho na https://console.anthropic.com/
ANTHROPIC_API_KEY=

# E-mailová adresa Gmail účtu, ze kterého se budou odesílat zprávy.
GMAIL_USER=
